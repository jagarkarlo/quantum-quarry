# This .gitignore is for Unity projects
# See https://github.com/github/gitignore/blob/main/Unity.gitignore
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/

# Autogenerated VS/Mono files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage

# OS generated files
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db

# Rider
.idea/
*.sln.iml

# Visual Studio Code
.vscode/

# User-specific
UserSettings/

# Avoid committing PackageCache and Library/PackageCache
Library/PackageCache/
Library/ArtifactDB

# Large source files that should use Git LFS when deliberately added
*.psd
*.mp4
*.mov
